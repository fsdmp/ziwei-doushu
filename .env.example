# 复制为 .env.local 后填入实际值

# ─── AI 解读后端（可选）───
# 默认已直连线上后端 https://mistsee.offiai.cn（/api/v1/ziwei/interpret、/api/v1/ziwei/heming，
# SSE 协议见 lib/ai.ts）。自建后端时才需要覆盖为你的地址：
# NEXT_PUBLIC_AI_API_BASE=https://your-backend.example.com

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 AI 后端代码，这组配置只在你自己实现了后端后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
